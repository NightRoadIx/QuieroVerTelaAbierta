<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuieroVerTelaAbierta.ViewModels"
             x:DataType="vm:ContadorViewModel"
             x:Class="QuieroVerTelaAbierta.Views.ContadorPage"
             Title="ContadorPage">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="{Binding Cuenta}"
                   FontSize="64"
                   HorizontalOptions="Center" />

            <Label Text="{Binding MensajeEstado}"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <Button Text="{Binding TextoBoton}"
                    Command="{Binding IncrementarCommand}" />

            <Button Text="Quitar uno"
                    Command="{Binding DecrementarCommand}" />

            <Button Text="Reiniciar"
                    Command="{Binding ReiniciarCommand}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="Máximo:"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding Maximo, Mode=TwoWay}"
                       Keyboard="Numeric" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
 </ContentPage>
